# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/desktop-canvas

# JWT Authentication Secret
JWT_SECRET=replace_with_your_super_secret_jwt_key_here
JWT_EXPIRES_IN=30d

# ---------------------------------------------------------------------------
# Cloudinary (OPTIONAL)
# Leave everything below empty/commented and uploaded templates are stored
# locally in backend/uploads/. Add credentials and uploads switch to
# Cloudinary automatically - no code changes needed.
# ---------------------------------------------------------------------------
# Option 1:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Option 2:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=desktop-canvas
