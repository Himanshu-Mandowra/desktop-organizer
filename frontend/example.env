# Frontend Configuration
GENERATE_SOURCEMAP=false
DISABLE_ESLINT_PLUGIN=true
REACT_APP_API_URL=http://localhost:5000/api

# Where "Save Layout" stores layouts:
#   local (default) -> cached in this browser (IndexedDB), no login/backend needed
#   cloud           -> saved to the backend/MongoDB (requires sign in)
REACT_APP_LAYOUT_STORAGE=local
